            android:action="android.intent.action.VIEW"
            android:data="quirzy://search"
            android:targetPackage="com.ps9labs.quirzy"
            android:targetClass="com.ps9labs.quirzy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="mocktest"
        android:enabled="true"
        android:icon="@drawable/shortcut_mock"
        android:shortcutShortLabel="@string/shortcut_mock_short"
        android:shortcutLongLabel="@string/shortcut_mock_long">
