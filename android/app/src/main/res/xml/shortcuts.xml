<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon. Each opens a quirzy:// link that
     DeepLinkService routes inside the app. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="daily"
        android:enabled="true"
        android:icon="@drawable/shortcut_daily"
        android:shortcutShortLabel="@string/shortcut_daily_short"
        android:shortcutLongLabel="@string/shortcut_daily_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="quirzy://daily"
            android:targetPackage="com.ps9labs.quirzy"
            android:targetClass="com.ps9labs.quirzy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
