            android:action="android.intent.action.VIEW"
            android:data="quirzy://mocktest"
            android:targetPackage="com.ps9labs.quirzy"
            android:targetClass="com.ps9labs.quirzy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="mistakes"
        android:enabled="true"
        android:icon="@drawable/shortcut_mistakes"
        android:shortcutShortLabel="@string/shortcut_mistakes_short"
        android:shortcutLongLabel="@string/shortcut_mistakes_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="quirzy://mistakes"
            android:targetPackage="com.ps9labs.quirzy"
            android:targetClass="com.ps9labs.quirzy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="practice"
        android:enabled="true"
        android:icon="@drawable/shortcut_practice"
        android:shortcutShortLabel="@string/shortcut_practice_short"
        android:shortcutLongLabel="@string/shortcut_practice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="quirzy://practice"
            android:targetPackage="com.ps9labs.quirzy"
            android:targetClass="com.ps9labs.quirzy.MainActivity" />
    </shortcut>
</shortcuts>
